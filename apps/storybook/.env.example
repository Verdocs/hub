# Copy to .env in this directory. Storybook's Vite builder loads it automatically.
# The API base defaults to beta if unset.
VITE_VERDOCS_API_BASE=https://api.verdocs.com

# Optional: a beta test account. When set and no session is already persisted,
# Storybook signs in on startup so live-data stories render without a manual
# login pass through the Auth story.
VITE_VERDOCS_TEST_EMAIL=you@example.com
VITE_VERDOCS_TEST_PASSWORD=changeme
