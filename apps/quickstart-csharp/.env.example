# Copy to .env and fill in. Get a client ID and secret by logging in at https://app.verdocs.com,
# then Settings > API Keys, and create a key with global admin access enabled.
VERDOCS_CLIENT_ID=
VERDOCS_CLIENT_SECRET=

# The PDF to send for signature. Relative paths resolve from this directory.
PDF_PATH=../../docs/sample-pdfs/blank.pdf

# Where the envelope goes. Leave this alone unless Verdocs told you otherwise.
VERDOCS_BASE_URL=https://api.verdocs.com

# Who receives the envelope. maildrop.cc is a throwaway inbox, fine for a first run.
SIGNER_EMAIL=test+user@maildrop.cc
SIGNER_FIRST_NAME=Test
SIGNER_LAST_NAME=User
