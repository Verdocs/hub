<?xml version="1.0" encoding="utf-8"?>
<!--
  Temporary. Verdocs.Sdk is not on NuGet.org yet, so the csproj's PackageReference has nothing to
  resolve against. Packing the SDK into local-packages/ and adding that folder as a source lets the
  project build exactly as it will once the package ships. Delete this file when Verdocs.Sdk is
  published and the reference will resolve from NuGet.org unchanged.

  From this directory:
    dotnet pack ../../sdks/csharp/src/Verdocs.Sdk -o local-packages
-->
<configuration>
  <packageSources>
    <add key="verdocs-local" value="local-packages" />
  </packageSources>
</configuration>
