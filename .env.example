# Copy to .env and fill in a beta (stage-api) test account.
# Used by the conformance suite and for manual verification of the quick-starts.
VERDOCS_API_BASE=https://stage-api.verdocs.com
VERDOCS_TEST_EMAIL=you@example.com
VERDOCS_TEST_PASSWORD=changeme

# Optional: IMAP mailbox for signup E2E verification-code retrieval.
VERDOCS_TEST_IMAP_HOST=imap.purelymail.com
VERDOCS_TEST_IMAP_USER=sdk-tests@example.com
VERDOCS_TEST_IMAP_PASSWORD=changeme
