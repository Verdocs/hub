{
  "$schema": "https://unpkg.com/@changesets/config@3.1.4/schema.json",
  "changelog": "../scripts/generate-changelog.mjs",
  "commit": false,
  "fixed": [
    [
      "@verdocs/js-sdk",
      "@verdocs/conformance"
    ],
    [
      "@verdocs/react-sdk",
      "@verdocs/angular-sdk",
      "@verdocs/vue-sdk",
      "@verdocs/wc-sdk",
      "verdocs-storybook"
    ]
  ],
  "linked": [],
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "verdocs-styled-builder",
    "verdocs-styled-signer",
    "@verdocs/collections"
  ],
  "privatePackages": {
    "version": true,
    "tag": true
  }
}