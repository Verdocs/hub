{
  "name": "@verdocs/wc-sdk",
  "private": false,
  "version": "6.10.5",
  "description": "Native Lit web components for building document workflows with Verdocs",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify && cem analyze",
    "setup:browser": "pnpm exec playwright install",
    "lint": "eslint .",
    "test": "pnpm run setup:browser && vitest run",
    "typecheck": "tsc --noEmit",
    "format": "eslint . --fix"
  },
  "dependencies": {
    "@verdocs/js-sdk": "workspace:^",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@tailwindcss/cli": "^4.3.3",
    "@verdocs/eslint-config": "^1.0.0",
    "@verdocs/typescript-config": "^1.0.0",
    "@vitest/browser-playwright": "^5.0.1",
    "axios": "^1.20.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.4",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
