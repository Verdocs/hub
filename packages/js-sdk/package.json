{
  "name": "@verdocs/js-sdk",
  "private": false,
  "version": "6.10.4",
  "homepage": "https://github.com/Verdocs/js-sdk",
  "description": "Isomorphic JS/TS SDK providing types and API wrappers for the Verdocs platform for Node and browser clients",
  "keywords": [
    "pdf",
    "document",
    "signing",
    "Verdocs",
    "embed"
  ],
  "author": "Verdocs",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "source": "./src/index.ts",
  "browser": "dist/browser.js",
  "files": [
    "dist/*",
    "node.js",
    "browser.js",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git://github.com/Verdocs/js-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Verdocs/js-sdk/issues"
  },
  "scripts": {
    "tsc": "pnpm run build",
    "build": "rollup -c --sourcemap --bundleConfigAsCjs",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs": "pnpm run generate-openapi && pnpm run generate-sdk-docs && pnpm run unify-sdks",
    "generate-openapi": "typedoc && npx tsx generated/openapi/generate-openapi.ts && cp openapi.json ../../../platform/apps/dev-docs/app/openapi.json",
    "generate-sdk-docs": "npx tsx generated/sdks/generate-sdks.ts",
    "unify-sdks": "npx tsx generated/sdks/unify-sdks.ts && cp unified-sdks.json ../../../platform/apps/dev-docs/app/unified-sdks.json",
    "edit-openapi": "docker run -p 8081:80 -v $(pwd):/sdk -v $(pwd):/sdk swaggerapi/swagger-editor:next-v5",
    "view-openapi": "docker run -p 8081:80 -v $(pwd):/sdk swaggerapi/swagger-ui",
    "push-beta": "pnpm run build && pnpm publish --tag beta && pnpm run docs",
    "push": "pnpm run build && pnpm publish && pnpm run docs",
    "format": "eslint . --fix"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@types/node": "^24.1.0",
    "axios-mock-adapter": "^2.1.0",
    "esbuild": "^0.25.10",
    "rollup": "^4.60.3",
    "rollup-plugin-clear": "^2.0.7",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-ts": "^3.4.5",
    "tsx": "4.23.1",
    "typedoc": "0.27.0-beta.0",
    "typescript": "5.9.3",
    "@verdocs/eslint-config": "^1.0.0",
    "eslint": "^9.39.4",
    "vitest": "^4.1.10"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}