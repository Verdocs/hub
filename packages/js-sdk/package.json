{
  "name": "@verdocs/js-sdk",
  "private": false,
  "version": "6.12.1",
  "homepage": "https://github.com/Verdocs/hub/tree/main/packages/js-sdk",
  "description": "Isomorphic JS/TS SDK providing types and API wrappers for the Verdocs platform for Node and browser clients",
  "keywords": [
    "pdf",
    "document",
    "signing",
    "Verdocs",
    "embed"
  ],
  "author": "Verdocs",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "source": "./src/index.ts",
  "browser": "dist/browser.js",
  "files": [
    "dist/*",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Verdocs/hub.git",
    "directory": "packages/js-sdk"
  },
  "bugs": {
    "url": "https://github.com/Verdocs/hub/issues"
  },
  "scripts": {
    "tsc": "pnpm run build",
    "build": "tsup",
    "prepare": "pnpm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "docs": "pnpm run generate-openapi && pnpm run generate-sdk-docs && pnpm run unify-sdks",
    "generate-openapi": "typedoc && tsx generated/openapi/generate-openapi.ts && cp openapi.json ../../../platform/apps/dev-docs/app/openapi.json",
    "generate-sdk-docs": "tsx generated/sdks/generate-sdks.ts",
    "unify-sdks": "tsx generated/sdks/unify-sdks.ts && cp unified-sdks.json ../../../platform/apps/dev-docs/app/unified-sdks.json",
    "edit-openapi": "docker run -p 8081:80 -v $(pwd):/sdk -v $(pwd):/sdk swaggerapi/swagger-editor:next-v5",
    "view-openapi": "docker run -p 8081:80 -v $(pwd):/sdk swaggerapi/swagger-ui",
    "push-beta": "pnpm run build && pnpm publish --tag beta && pnpm run docs",
    "push": "pnpm run build && pnpm publish && pnpm run docs",
    "format": "eslint . --fix"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@verdocs/eslint-config": "^1.0.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  }
}
