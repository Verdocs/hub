{
  "name": "@verdocs/vue-sdk",
  "private": false,
  "version": "6.10.5",
  "description": "Native Vue 3 components, composables, and provider for building document workflows with Verdocs",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "start": "vite build --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "format": "eslint . --fix"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.103.1",
    "@verdocs/js-sdk": "workspace:^"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@typescript-eslint/parser": "^8.70.0",
    "@verdocs/eslint-config": "^1.0.0",
    "@verdocs/typescript-config": "^1.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "axios": "^1.20.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
