{
  "name": "@verdocs/collections",
  "private": true,
  "version": "1.0.0",
  "description": "Generates the committed Postman and Bruno collections in collections/ from the js-sdk OpenAPI spec",
  "type": "module",
  "scripts": {
    "generate": "tsx src/generate.ts",
