{
  "name": "@verdocs/conformance",
  "private": true,
  "version": "6.12.3",
  "description": "Curl-vs-SDK conformance harness: every covered endpoint is called with raw curl and with the SDK, and the responses are diffed",
  "type": "module",
  "scripts": {
    "conformance": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "eslint . --fix"
  },
  "dependencies": {
    "@verdocs/js-sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "@verdocs/eslint-config": "^1.0.0",
    "@verdocs/typescript-config": "^1.0.0",
    "eslint": "^9.39.4",
    "imapflow": "^2.0.5",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  }
}
