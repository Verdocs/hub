{
  "name": "@verdocs/hub",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:report": "vitest run",
    "conformance": "pnpm --if-present --no-bail -r run conformance",
    "generate:docs": "node scripts/clean-sdk-docs.mjs && turbo run generate-sdk-docs && pnpm --filter @verdocs/js-sdk docs",
    "changeset:version": "changeset version",
    "changeset:add": "changeset",
    "changeset:status": "changeset status",
    "changeset:publish": "changeset publish",
    "changeset:docs": "node ./scripts/generate-changelog.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@vitest/ui": "^4.1.10",
    "turbo": "^2.10.8",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24"
  }
}