<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0 only: the local toolchain has just the net10 runtime installed, and xunit v3
       test projects build as executables. The library still multi-targets net8.0. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.7.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Verdocs.Sdk/Verdocs.Sdk.csproj" />
  </ItemGroup>

</Project>
