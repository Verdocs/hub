meta {
  name: Add email domain
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v2/organizations/:organizationid/brands/:brandid/email-domain
  body: json
  auth: inherit
}

params:path {
  organizationid:
  brandid:
}

body:json {
  {
    "subdomain": "string",
    "local_part": "string"
  }
}
