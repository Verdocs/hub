meta {
  name: Create notification template
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v2/notifications/templates
  body: json
  auth: inherit
}

body:json {
  {
    "type": "sms",
    "event_name": "string",
    "template_id": "string",
    "html_template": "string",
    "text_template": "string"
  }
}
