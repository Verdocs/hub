meta {
  name: Authenticate
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v2/oauth2/token
  body: json
  auth: inherit
}

body:json {
  {
    "grant_type": "client_credentials",
    "client_id": "00000000-0000-0000-0000-000000000000",
    "client_secret": "00000000-0000-0000-0000-000000000000",
    "username": "string",
    "password": "string",
    "code": "string",
    "redirect_uri": "https://example.com",
    "scope": "string"
  }
}
