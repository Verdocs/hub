meta {
  name: Create a template
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v2/templates
  body: json
  auth: inherit
}

body:json {
  {
    "name": "string",
    "description": "string",
    "visibility": "private",
    "is_personal": true,
    "is_public": true,
    "sender": "envelope_creator",
    "initial_reminder": 0,
    "followup_reminders": 0,
    "max_reminder_days": 0,
    "documents": [
      {}
    ],
    "roles": [
      {
        "id": "string",
        "name_locked": true,
        "order": 0,
        "sequence": 0
      }
    ],
    "fields": []
  }
}
