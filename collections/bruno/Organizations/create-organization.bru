meta {
  name: Create organization
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v2/organizations
  body: json
  auth: inherit
}

body:json {
  {
    "name": "string",
    "parent_id": "string",
    "contact_email": "string",
    "url": "string",
    "full_logo_url": "string",
    "thumbnail_url": "string",
    "primary_color": "string",
    "secondary_color": "string",
    "terms_use_url": "string",
    "privacy_policy_url": "string",
    "powered_by_label": "string",
    "powered_by_url": "string",
    "timezone": "string",
    "locale": "string",
    "disclaimer": "string",
    "data": {},
    "deletion_protected": true
  }
}

docs {
  The caller will be assigned an "Owner" profile in the new organization, and it will be set to "current" automatically. A new set of session tokens will be issued to  the caller, and the caller should update their endpoint to use the new tokens.
}
