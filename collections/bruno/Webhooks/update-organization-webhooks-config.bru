meta {
  name: Update organization Webhooks config
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/v2/webhooks
  body: json
  auth: inherit
}

body:json {
  {
    "url": "string",
    "active": true,
    "auth_method": "none",
    "token_endpoint": "string",
    "client_id": "string",
    "client_secret": "string",
    "scope": "string",
    "events": {}
  }
}

docs {
  Note that Webhooks cannot currently be deleted, but may be easily disabled by setting
}
