meta {
  name: Ask Sender a Question
  type: http
  seq: 2
}

post {
  url: {{base_url}}/envelopes/:envelope_id/recipients/:role_name/ask-question
  body: json
  auth: inherit
}

params:path {
  envelope_id: 00000000-0000-0000-0000-000000000000
  role_name:
}

body:json {
  {
    "question": "string"
  }
}

docs {
  Path parameters:
  - envelope_id: The envelope to operate on.
  - role_name: The role name to update.
}
