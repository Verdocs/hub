meta {
  name: Start Signing Session
  type: http
  seq: 6
}

post {
  url: {{base_url}}/v2/sign/unauth/:envelope_id/:role_name/:key
  body: none
  auth: inherit
}

params:path {
  envelope_id: 00000000-0000-0000-0000-000000000000
  role_name:
  key:
}

docs {
  Path parameters:
  - envelope_id: The envelope to operate on.
  - role_name: The role to request.
  - key: Access key generated by the envelope creator or email/SMS invite.
}
