meta {
  name: Update a profile
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/v2/profiles/:profile_id
  body: json
  auth: inherit
}

params:path {
  profile_id:
}

body:json {
  {
    "first_name": "string",
    "last_name": "string",
    "phone": "string",
    "permissions": [
      "string"
    ],
    "roles": [
      "contact"
    ],
    "timezone": "string",
    "locale": "string"
  }
}
